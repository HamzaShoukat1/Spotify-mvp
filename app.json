{
  "expo": {
    "name": "Spotify",
    "slug": "Spotify-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spotifymvp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/AppIcon.png",
      "bundleIdentifier": "com.hamza.spotifymvp"
    },
    "android": {
      "package": "com.hamza.spotifymvp",
      "icon": "./src/assets/images/AppIcon.png",
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1DB954",
        "foregroundImage": "./src/assets/images/AppIcon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/AppIcon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yourcompany.app",
          "ios": {
            "merchantIdentifier": "merchant.com.yourcompany.app"
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1DB954",
          "image": "./src/assets/images/AppIcon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false,
            "newArch": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9985392-d7d8-47ef-b74e-a7eedeb300cf"
      }
    }
  }
}
