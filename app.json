{
  "expo": {
    "name": "Spotify",
    "slug": "Spotify-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spotifymvp",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": "./src/assets/images/AppIcon.png",
      "bundleIdentifier": "com.hamza.spotifymvp"
    },
    "android": {
      "package": "com.hamza.spotifymvp",
      "icon": "./src/assets/images/AppIcon.png",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1DB954",
        "foregroundImage": "./src/assets/images/AppIcon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yourcompany.app",
          "ios": {
            "merchantIdentifier": "merchant.com.yourcompany.app"
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1DB954",
          "image": "./src/assets/images/AppIcon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn com.stripe.android.pushProvisioning.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9985392-d7d8-47ef-b74e-a7eedeb300cf"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e9985392-d7d8-47ef-b74e-a7eedeb300cf"
    }
  }
}
